{
  "framework": "nextjs",
  "functions": {
    "api/py/index.py": {
      "maxDuration": 60,
      "includeFiles": "models/{xgboost.json,random_forest.pkl,logistic_regression.pkl,scaler.pkl,trained_columns.txt}"
    }
  },
  "rewrites": [
    {
      "source": "/api/py/:path*",
      "destination": "/api/py"
    }
  ]
}
