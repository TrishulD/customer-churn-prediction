# ==============================================================================
# Customer Churn Prediction - Environment Variables
# ==============================================================================

# 1. Supabase Credentials (Get these from your Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Python ML Inference Service URL
# In local development: http://127.0.0.1:8000
# In production: Your deployed FastAPI service URL (e.g., https://churn-ml-api.onrender.com or Fly.io)
ML_INFERENCE_URL=http://127.0.0.1:8000

# 3. Admin Dashboard Passkey (Change this to your secure passphrase)
ADMIN_PASSWORD=admin123
