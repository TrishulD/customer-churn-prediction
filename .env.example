# ==============================================================================
# Customer Churn Prediction - Environment Variables
# ==============================================================================

# 1. Supabase Credentials (Get these from your Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Python ML Inference Service URL
# Local development: start FastAPI with: uvicorn src.api:app --host 127.0.0.1 --port 8000
# On Vercel: leave this unset — VERCEL_URL is auto-injected and the Next.js
#            predict route will automatically call https://<deployment>.vercel.app/api/py
# Only set this if you need to override the auto-detected URL:
# ML_INFERENCE_URL=http://127.0.0.1:8000

# 3. Admin Dashboard Passkey (Change this to your secure passphrase)
ADMIN_PASSWORD=admin123
